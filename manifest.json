{
  "manifest_version": 2,
  "name": "Usage Badge for Claude.ai",
  "version": "1.0.7",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "author": "dev.ilsix@ilsix.email",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage",
    "https://claude.ai/*"
  ],
  "background": {
    "scripts": ["i18n.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Usage Badge for Claude.ai",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-usage@ilsix.email",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
